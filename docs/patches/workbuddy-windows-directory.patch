new file mode 100644
--- /dev/null
+++ b/src/node-directory.ts
@@ -0,0 +1,21 @@
+/** Remote paths use the node's syntax, never the platform server's OS syntax. */
+import { posix, win32 } from 'node:path'
+const windows = (value: string) => /^[a-z]:[\\/]/i.test(value)
+export function normalizeNodeDirectory(value: string): string {
+  if (!value || value.length > 2048 || /[\x00-\x1f\x7f]/.test(value)) throw new Error('INVALID_DIRECTORY')
+  if (windows(value)) {
+    if (value.slice(2).includes(':') || /[*?"<>|]/.test(value) || value.slice(3).split(/[\\/]/).some(p => /[. ]$/.test(p) && p !== '.' && p !== '..')) throw new Error('INVALID_DIRECTORY')
+    const result = win32.normalize(value.replace(/\//g, '\\'))
+    return result.length > 3 ? result.replace(/\\$/, '') : result
+  }
+  if (!posix.isAbsolute(value) || value.includes('\\') || value.startsWith('//')) throw new Error('INVALID_DIRECTORY')
+  return posix.normalize(value).replace(/\/$/, '') || '/'
+}
+export function nodeDirectoryContains(root: string, directory: string): boolean {
+  if (windows(root) !== windows(directory)) return false
+  if (windows(root)) {
+    const rel = win32.relative(root, directory)
+    return !rel || rel !== '..' && !rel.startsWith('..\\') && !win32.isAbsolute(rel)
+  }
+  return directory === root || directory.startsWith(root === '/' ? '/' : root + '/')
+}
