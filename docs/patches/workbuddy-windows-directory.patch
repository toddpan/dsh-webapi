+++ b/src/node-directory.test.ts
@@ -0,0 +1,18 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { normalizeNodeDirectory as normalize, nodeDirectoryContains as contains } from './node-directory.js'
+test('accepts Windows node roots on Linux server without changing their native representation', () => {
+  assert.equal(normalize('C:\\Users\\user\\project'), 'C:\\Users\\user\\project')
+  assert.equal(normalize('C:/Users/user/project/'), 'C:\\Users\\user\\project')
+  assert.equal(normalize('/home/user/project/'), '/home/user/project')
+  assert.equal(normalize('C:\\'), 'C:\\')
+})
+test('directory boundaries reject sibling prefixes traversal and other drives', () => {
+  assert.equal(contains('C:\\Work', 'c:\\work\\project'), true)
+  for (const target of ['C:\\Work2', 'C:\\Work\\..\\secret', 'D:\\Work', '/Work']) assert.equal(contains('C:\\Work', target), false)
+  assert.equal(contains('/home/User', '/home/user/project'), false)
+  assert.equal(contains('/home/user', '/home/user2'), false)
+})
+test('rejects relative device UNC and alternate stream paths', () => {
+  for (const value of ['C:project','project','\\\\server\\share','\\\\?\\C:\\project','C:\\project:stream','C:\\bad?name']) assert.throws(()=>normalize(value))
+})
